# Copy to .env and fill in what you have. Everything works with the defaults (offline stub, no keys).
PER_VISITOR_DATA=true        # each visitor gets their own empty app; false = one shared database file (DB_PATH)
LLM_PROVIDER=stub            # stub | gemini | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PLAID_CLIENT_ID=
PLAID_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
LOW_CASH_LINE=2000
CURRENCY=USD
